{
  "name": "zuzsso/php-rag-jira-triage",
  "license": "MIT",
  "description": "Zero-framework Retrieval-Augmented Generation (RAG) & automated ticket triage engine built in Vanilla PHP and MariaDB 11.7 native vector search, grounded in public Atlassian Jira bug resolutions.",
  "type": "project",
  "authors": [
    {
      "name": "Nicolas Santamaria",
      "email": "ndsans@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "JiRag\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JiRag\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "php-di/php-di": "^7.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "zuzsso/di-manifest": "^2.0",
    "zuzsso/typed-collection": "^2.0",
    "zuzsso/json-validator": "^4.0",
    "zuzsso/math": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.2.3",
    "phpmd/phpmd": "@stable",
    "friendsofphp/php-cs-fixer": "*"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/zuzsso/di-manifest"
    },
    {
      "type": "vcs",
      "url": "https://github.com/zuzsso/typed-collection"
    },
    {
      "type": "vcs",
      "url": "https://github.com/zuzsso/json-validator"
    },
    {
      "type": "vcs",
      "url": "https://github.com/zuzsso/math"
    }
  ]
}
